          "minimum": 0,
          "title": "Origin Days",
          "type": "integer"
        },
        "output_format": {
          "const": "csv",
          "title": "Output Format",
          "type": "string"
        },
        "products": {
          "exclusiveMinimum": 0,
          "title": "Products",
          "type": "integer"
        },
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "seed": {
          "exclusiveMinimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "start_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
