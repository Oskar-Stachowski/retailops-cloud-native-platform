        "profile",
        "days",
        "products",
        "stores",
        "warehouses",
        "seed",
        "start_date",
        "end_date",
        "max_daily_rows",
        "business_timezone",
        "output_format",
        "warmup_days",
        "origin_days",
        "label_tail_days"
