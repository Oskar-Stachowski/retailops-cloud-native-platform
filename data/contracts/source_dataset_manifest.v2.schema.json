    "schema_version": {
      "enum": [
        "2.0.0",
        "2.1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "watermarks": {
      "additionalProperties": {
        "$ref": "#/$defs/Watermark"
      },
      "title": "Watermarks",
      "type": "object"
    }
  },
  "required": [
