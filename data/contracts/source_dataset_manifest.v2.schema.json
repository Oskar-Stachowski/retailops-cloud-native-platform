            {
              "type": "null"
            }
          ],
          "title": "End Date"
        },
        "max_daily_rows": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Daily Rows"
        },
        "products": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Products"
        },
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "seed": {
          "exclusiveMinimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "start_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Date"
