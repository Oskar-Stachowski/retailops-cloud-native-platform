          "type": "string"
        },
        "config": {
          "const": "1.0.0",
          "title": "Config",
          "type": "string"
        },
        "csv_schema": {
          "const": "1.0",
          "title": "Csv Schema",
          "type": "string"
        },
        "dimensions": {
          "anyOf": [
            {
              "enum": [
                "retail-dimensions-1.0.0",
                "not_applicable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        },
        "generator": {
          "enum": [
            "0.2.0",
            "0.3.0"
          ],
          "title": "Generator",
          "type": "string"
        }
