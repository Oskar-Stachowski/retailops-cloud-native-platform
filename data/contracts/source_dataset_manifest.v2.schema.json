{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "data_class": {
          "enum": [
            "source_observation",
            "mixed_fact_and_simulation_truth",
            "source_operational_output",
            "source_plan"
          ],
          "title": "Data Class",
          "type": "string"
        },
        "date_range": {
          "$ref": "#/$defs/DateRange"
        },
        "field_ranges": {
          "additionalProperties": {
            "$ref": "#/$defs/DateRange"
          },
          "title": "Field Ranges",
          "type": "object"
        },
        "future_range": {
          "$ref": "#/$defs/DateRange"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "history_range": {
          "$ref": "#/$defs/DateRange"
        },
        "open_interval_rows": {
          "minimum": 0,
          "title": "Open Interval Rows",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "temporal_role": {
          "enum": [
            "dimension",
            "observations",
            "plans",
            "return_tail",
            "operational_output"
          ],
          "title": "Temporal Role",
          "type": "string"
        }
      },
      "required": [
        "table",
        "path",
        "sha256",
        "size_bytes",
        "row_count",
        "content_sha256",
        "schema_version",
        "columns",
        "grain",
        "data_class",
        "temporal_role",
        "date_range",
        "field_ranges",
        "history_range",
        "future_range",
        "open_interval_rows"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "date_end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date End"
        },
        "date_start": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Start"
        },
        "value_count": {
          "minimum": 0,
          "title": "Value Count",
          "type": "integer"
        }
      },
      "required": [
        "date_start",
        "date_end",
        "value_count"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "code_state": {
          "enum": [
            "clean",
            "modified",
            "unavailable"
          ],
          "title": "Code State",
          "type": "string"
        },
        "dependency_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Dependency Files",
          "type": "object"
        },
        "dependency_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Sha256",
          "type": "string"
        },
        "git_commit": {
          "pattern": "^(?:[0-9a-f]{40}|unavailable)$",
          "title": "Git Commit",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "code_sha256",
        "dependency_sha256",
        "code_files",
        "dependency_files",
        "python_version",
        "git_commit",
        "code_state"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Readiness": {
      "additionalProperties": false,
      "properties": {
        "anomaly": {
          "const": "not_ready",
          "title": "Anomaly",
          "type": "string"
        },
        "forecasting": {
          "const": "not_ready",
          "title": "Forecasting",
          "type": "string"
        },
        "rag": {
          "const": "not_applicable",
          "title": "Rag",
          "type": "string"
        },
        "replay": {
          "const": "not_ready",
          "title": "Replay",
          "type": "string"
        },
        "stockout": {
          "const": "not_ready",
          "title": "Stockout",
          "type": "string"
        }
      },
      "required": [
        "forecasting",
        "anomaly",
        "stockout",
        "replay",
        "rag"
      ],
      "title": "Readiness",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "policy_version",
        "status"
      ],
      "title": "Report",
      "type": "object"
    },
