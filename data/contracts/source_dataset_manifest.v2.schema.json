    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "inventory_ready": {
      "const": false,
      "title": "Inventory Ready",
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "readiness": {
      "$ref": "#/$defs/Readiness"
    },
    "reports": {
      "items": {
        "$ref": "#/$defs/Report"
      },
      "title": "Reports",
      "type": "array"
    },
    "requested_parameters": {
      "$ref": "#/$defs/RequestedParameters"
