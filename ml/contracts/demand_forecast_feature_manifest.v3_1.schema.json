{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retailops.local/schemas/ml/demand_forecast_feature_manifest.v3.schema.json",
  "title": "RetailOps Demand Forecast Feature Dataset Manifest",
  "description": "Manifest for a generated demand forecasting feature dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "dataset_name",
    "schema_version",
    "feature_schema",
    "profile",
    "grain",
    "target",
    "date_start",
    "date_end",
    "formats",
    "row_count",
    "source_artifacts",
    "forecast_origin_rule",
    "available_at_origin_fields",
    "label_fields",
    "observation_availability_field",
    "inventory_ready",
    "complete_daily_panel",
    "generated_at",
    "target_type"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_name": {
      "type": "string",
      "const": "retailops-demand-forecast-features"
    },
    "schema_version": {
      "type": "string",
      "const": "3.1"
    },
    "feature_schema": {
      "type": "string",
      "const": "demand_forecast_features.v3_1.schema.json"
    },
    "profile": {
      "type": "string",
      "enum": [
        "ai-smoke",
        "ai-temporal-smoke",
        "ai-dev",
        "ai-training",
        "ai-load"
      ]
    },
    "grain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "prefixItems": [
        {
          "const": "date"
        },
        {
          "const": "product_id"
        },
        {
          "const": "selling_location_id"
        },
        {
          "const": "channel"
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "const": [
        "date",
        "product_id",
        "selling_location_id",
        "channel"
      ]
    },
    "target": {
      "type": "string",
      "const": "units_sold"
    },
    "date_start": {
      "type": "string",
      "format": "date"
    },
    "date_end": {
      "type": "string",
      "format": "date"
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "csv",
          "parquet",
          "jsonl"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "forecast_origin_rule": {
      "type": "string",
      "const": "previous_day_end_utc"
    },
    "available_at_origin_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "label_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "const": [
        "units_sold",
        "observation_status"
      ]
    },
    "observation_availability_field": {
      "type": "string",
      "const": "observation_available_at"
    },
    "inventory_ready": {
      "type": "boolean",
      "const": false
    },
    "complete_daily_panel": {
      "type": "boolean",
      "const": true
    },
    "quality_report": {
      "type": "string"
    },
    "generator_version": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_type": {
      "type": "string",
      "const": "observed_sales_units"
    }
  }
}
